{
	"name": "convertio",
	"version": "0.1.0",
	"private": true,
	"description": "Convertisseur de formats d'image 100 % local, dans le navigateur",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"generate-pwa-assets": "pwa-assets-generator",
		"generate-assets": "pnpm build && node scripts/generate-assets.mjs",
		"deploy:pages": "pnpm build && wrangler pages deploy"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"heroicons": "^2.2.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.3",
		"workbox-expiration": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.146.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@jsquash/avif": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/jxl": "^1.3.0",
		"@jsquash/oxipng": "^2.3.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"@tailwindplus/elements": "^1.0.22",
		"client-zip": "^2.5.1",
		"comlink": "^4.4.2",
		"gifenc": "^1.0.3",
		"libheif-js": "^1.23.2",
		"utif": "^3.1.0"
	}
}
